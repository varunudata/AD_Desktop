# ClassFlow - Environment Configuration Example
# Copy this file to .env and configure your PostgreSQL connection string.
# DO NOT COMMIT THE REAL .env FILE TO GIT REPOSITORY.

# Example Neon PostgreSQL connection string (pooled or direct):
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Alternatively, for a local PostgreSQL server:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/classflow?schema=public"

# Application Settings
NODE_ENV="development"
PORT=3000
